{
  "format_version": "dcg-vega-provenance-integrity-correction-v2",
  "finding": "versioned-schema-filenames-are-not-git-refs",
  "direct_ref_checks": [
    {
      "command": "git rev-parse v2.7.0",
      "exit_code": 128,
      "result": "unknown revision or path"
    },
    {
      "command": "git rev-parse v3.0.0",
      "exit_code": 128,
      "result": "unknown revision or path"
    }
  ],
  "root_cause": "The first pre-screen treated base_revision and candidate_revision as versioned schema filenames but populated both per-side commit fields with the repository snapshot commit. The schema bytes and blob IDs were correct, but the commit fields did not identify the commits that last produced each version file. The first persisted source clone was also shallow, which prevented reliable file-history resolution.",
  "pipeline_correction": {
    "full_history_required": true,
    "shallow_repository_rejected": true,
    "commit_resolution": "git log -1 --format=%H <snapshot> -- <versioned-file-path>",
    "blob_resolution": "git rev-parse <resolved-file-commit>:<versioned-file-path>",
    "snapshot_blob_cross_check_required": true
  },
